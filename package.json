{
  "name": "infu",
  "version": "0.1.0",
  "private": true,
  "description": "InFu",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @infu/shared && npm run build -w @infu/sandbox-rs && npm run build -w @infu/agent",
    "infu": "npm run cli -w @infu/agent --",
    "config": "npm run cli -w @infu/agent -- config",
    "start": "npm run start -w @infu/agent",
    "test": "npx tsx scripts/test-runner.ts",
    "probe": "npx tsx scripts/probe.ts"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "electron-builder": "^26.15.3"
  }
}
