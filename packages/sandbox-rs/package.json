{
  "name": "@infu/sandbox-rs",
  "version": "0.1.0",
  "private": true,
  "description": "InFu Windows 硬沙箱原生模块（restricted tokens + job objects，借鉴 OpenAI Codex）",
  "main": "index.node",
  "types": "index.d.ts",
