{
  "name": "infu",
  "version": "1.0.1",
  "private": true,
  "description": "Local coding agent for Windows",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @infu/shared && npm run build -w @infu/sandbox-rs && npm run build -w @infu/agent",
    "infu": "npm run cli -w @infu/agent --",
    "config": "npm run cli -w @infu/agent -- config",
    "start": "npm run start -w @infu/agent",
    "test": "npx tsx scripts/test-runner.ts",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\" \"packages/*/tests/**/*.ts\" --max-warnings 0",
    "probe": "npx tsx scripts/probe.ts",
    "release:verify": "node scripts/release-check.mjs",
    "release:pack": "npm run release:verify && npm run pack -w @infu/desktop && node scripts/package-audit.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  }
}
